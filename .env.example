# Copy to .env and adjust. Every value here has a safe default for local
# development; the ones marked REQUIRED must be set in production.

# --- Django core -----------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -m django shell -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Never run with DEBUG=True in production.
DEBUG=True

# REQUIRED in production. Comma-separated hostnames that may serve this app.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins (with scheme) trusted for form POSTs over HTTPS.
# On Render this is derived from RENDER_EXTERNAL_HOSTNAME automatically.
CSRF_TRUSTED_ORIGINS=

# Set to False if TLS is terminated somewhere that does not set
# X-Forwarded-Proto, otherwise leave the default.
SECURE_SSL_REDIRECT=True

# --- Recommendation model --------------------------------------------------
# OPTIONAL. Directory containing movie_metadata.parquet, title_to_idx.json,
# config.json and the similarity data. Relative paths resolve against the
# project root. Leave unset to use the committed demo_model/ -- the app also
# checks models/, demo_model/ and static/ in that order.
# MODEL_DIR=models

# Optional, BUILD TIME ONLY (used by render.yaml, never fetched at runtime).
# A .tar.gz of a trained model directory -- for example a GitHub Release asset.
# Create one with:  tar czf model.tar.gz -C models --exclude='*.pkl' .
# MODEL_URL=https://github.com/<you>/<repo>/releases/download/v2.1/model.tar.gz

# How many recommendations a search returns.
RECOMMENDATION_COUNT=15

# --- Database --------------------------------------------------------------
# Only used for Django's session/auth tables; the recommender is file-backed.
SQLITE_PATH=
